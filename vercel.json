{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "index.php": {
      "runtime": "vercel-php@0.7.4"
    },
    "conn.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "source": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
